@{
    ViewData["Title"] = "Animal Care Clinic - Dashboard 🐶";
}

<style>
    body {
        background-color: #f6f9ff;
        font-family: "Segoe UI", Arial, sans-serif;
    }

    /*baby blue navbar*/
    .navbar {
        background-color: #a8c9ff !important; /* baby blue */
    }

    footer {
        background-color: #dbe8ff;
        padding: 15px 0;
        color: #003366;
        font-weight: 500;
    }

    .container main {
        background: white;
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0px 4px 15px rgba(0,0,0,0.08);
    }

    .btn-primary {
        background-color: #4d8bff;
        border-color: #4d8bff;
    }

        .btn-primary:hover {
            background-color: #3a6fd6;
            border-color: #3a6fd6;
        }
</style>

<div class="hero-section text-center">
    <div class="container">
        <h1 class="display-4 mb-4">Welcome to Animal Care Clinic</h1>
        <p class="lead mb-4">Providing exceptional care for your beloved pets since 2024</p>
        <a asp-controller="Appointments" asp-action="Create" class="btn btn-light btn-lg">
            <i class="fas fa-calendar-plus me-2"></i>Schedule Appointment
        </a>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card stat-card text-center">
            <div class="card-body">
                <i class="fas fa-calendar-day fa-2x text-primary mb-3"></i>
                <h3>@ViewBag.TodayAppointments</h3>
                <p class="card-text">Today's Appointments</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card text-center">
            <div class="card-body">
                <i class="fas fa-paw fa-2x text-success mb-3"></i>
                <h3>@ViewBag.TotalPets</h3>
                <p class="card-text">Registered Pets</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card text-center">
            <div class="card-body">
                <i class="fas fa-user-md fa-2x text-info mb-3"></i>
                <h3>@ViewBag.TotalVets</h3>
                <p class="card-text">Veterinarians</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card text-center">
            <div class="card-body">
                <i class="fas fa-check-circle fa-2x text-warning mb-3"></i>
                <h3>@ViewBag.CompletedToday</h3>
                <p class="card-text">Completed Today</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-clock me-2"></i>Today's Appointments
                </h5>
            </div>
            <div class="card-body">
                <p class="text-muted">View and manage today's scheduled appointments.</p>
                <a asp-controller="Appointments" asp-action="Index" class="btn btn-outline-primary">
                    View All Appointments
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-chart-bar me-2"></i>Monthly Reports
                </h5>
            </div>
            <div class="card-body">
                <p class="text-muted">Generate monthly activity and workload reports.</p>
                <a asp-controller="Reports" asp-action="Monthly" class="btn btn-outline-success">
                    Generate Reports
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-info-circle me-2"></i>Quick Actions
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 mb-2">
                        <a asp-controller="Pets" asp-action="Create" class="btn btn-outline-primary w-100">
                            <i class="fas fa-plus me-2"></i>Add New Pet
                        </a>
                    </div>
                    <div class="col-md-3 mb-2">
                        <a asp-controller="Owners" asp-action="Create" class="btn btn-outline-secondary w-100">
                            <i class="fas fa-user-plus me-2"></i>Register Owner
                        </a>
                    </div>
                    <div class="col-md-3 mb-2">
                        <a asp-controller="ClinicalHistories" asp-action="Create" class="btn btn-outline-info w-100">
                            <i class="fas fa-file-medical me-2"></i>Add Clinical Record
                        </a>
                    </div>
                    <div class="col-md-3 mb-2">
                        <a asp-controller="Veterinarians" asp-action="Index" class="btn btn-outline-warning w-100">
                            <i class="fas fa-user-md me-2"></i>Manage Vets
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Animal_Clinic_Project_MVC_Group3</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Animal_Clinic_Project_MVC_Group3.styles.css" asp-append-version="true" />

    <style>
        body {
            background-color: #f6f9ff;
            font-family: "Segoe UI", Arial, sans-serif;
        }

        /* NAVBAR BLUE */
        .navbar {
            background-color: #a8c9ff !important; /* Baby blue */
        }

        .navbar-brand, .nav-link {
            color: #003366 !important; /* Baby blue */
            font-weight: 600;
        }

        .nav-link:hover {
            color: #002244 !important;
            text-decoration: underline;
        }

        /* FOOTER */
        footer {
            background-color: #dbe8ff;
            padding: 15px 0;
            color: #003366; /* Baby blue */
            font-weight: 500;
            margin-top: auto;
            position: fixed;
            bottom: 0;
            width: 100%;
        }

        /* containers with shadow */
        .container main {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0px 4px 15px rgba(0,0,0,0.08);
        }

        /* baby blue buttons */
        .btn-primary {
            background-color: #4d8bff;
            border-color: #4d8bff;
        }

            /* baby blue buttons */
        .btn-primary:hover {
            background-color: #3a6fd6;
            border-color: #3a6fd6;
        }

        /* Links */
        a {
            color: #2e5aac;
        }
        a:hover {
            color: #1d3e82;
        }
    </style>

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Animal Clinic Group3</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="clinicUsersDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false"> Users</a>


                                <ul class="dropdown-menu" aria-labelledby="clinicUsersDropdown">

                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="ClinicUsers" asp-action="Index">All Users</a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Administrators" asp-action="Index">Administrators</a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Receptionists" asp-action="Index">Receptionists</a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Veterinarians" asp-action="Index">Veterinarians</a>
                                    </li>

                                </ul>

                            </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Owners" asp-action="Index">Owners</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Pets" asp-action="Index">Pets</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Appointments" asp-action="Index">Appointments</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="ClinicalHistories" asp-action="Index">Clinical Histories</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Reports" asp-action="SelectReport">Monthly Report</a>
                        </li>
                        @* Views *@
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="DailyAppointments" asp-action="Index">Daily Appointments</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="VetsWorkload" asp-action="Index">Vets Workload</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="PetClinicH" asp-action="Index">Pet Clinic History</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="VetsAvailability" asp-action="Index">Vets Availability</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Animal_Clinic_Project_MVC_Group3 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
